# Lunova Backend - Environment Variables
#
# Kopyala: cp .env.example .env
# Docker Compose ile kullanılıyorsa değiştirmenize gerek yok; aşağıdaki değerler
# zaten Docker Compose ağı ile (SQLite + mock storage + host'a mape edilmiş
# frontend portları) çalışacak şekilde ayarlandı.

DEBUG=True
ENVIRONMENT=Development

# Dev ortamında gerçek bir gizli anahtar olmasına gerek yok, ama boş da olamaz
# (settings.py env.str('SECRET_KEY') default'suz okuyor).
SECRET_KEY=dev-only-insecure-secret-key-change-before-production

# Django Host header kontrolü. Backend Docker'da 8000 portunda host'a mapleniyor,
# tarayıcı her zaman localhost/127.0.0.1 üzerinden erişecek.
ALLOWED_HOSTS=localhost,127.0.0.1

# 'Lunova-lite' -> backend/db.sqlite3 kullanılır (bkz. settings.py).
# PostgreSQL'e geçmek isterseniz: DB_URI=postgresql://user:pass@host:5432/dbname
DB_URI=Lunova-lite

# 'mock' -> dosya yükleme Supabase'e gitmez, bellek içi sahte storage kullanılır.
STORAGE_PROVIDER=mock

# Development'ta CORS zaten settings.py içinde localhost:5173/5174 olarak
# hardcoded; FRONTEND_URLS asıl olarak şifre sıfırlama e-postasındaki link için
# kullanılıyor. Yine de env.json() zorunlu olduğu için boş bırakılamaz.
FRONTEND_URLS={"expert": "http://localhost:5173", "client": "http://localhost:5174", "admin": "http://localhost:8000/admin"}

# Zoom entegrasyonu Development ortamında hiç çağrılmıyor (appointments/views.py
# ENVIRONMENT=='Production' değilse mock veri döner) ama settings.py bu
# değişkenleri default'suz okuduğu için boş olamazlar; gerçek Zoom credentials'ı
# olmadan da uygulama sorunsuz açılır.
ZOOM_CLIENT_ID=dev-placeholder
ZOOM_CLIENT_SECRET=dev-placeholder
ZOOM_ACCOUNT_ID=dev-placeholder

# iyzico ödeme entegrasyonu - 'mock' modda gerçek iyzico'ya hiç ağ isteği
# gitmez, aşağıdaki key değişkenlerinin hiçbiri gerekmez. Sandbox/production
# key'leriniz olduğunda IYZICO_MODE'u değiştirip ilgili key çiftini
# (IYZICO_SANDBOX_* ya da IYZICO_PRODUCTION_*) doldurmanız yeterli - ikisi de
# aynı anda .env'de durabilir, hangisinin okunacağını sadece IYZICO_MODE belirler.
# (mock/sandbox/production)
IYZICO_MODE=mock
IYZICO_SANDBOX_API_KEY=sandbox-Zvrpx6rNVhru6O9o3XyauRHzqVKt8PT0
IYZICO_SANDBOX_SECRET_KEY=sandbox-J2kG1DrydZdpyjX9Yf1TIUME6Tw2Lsqu
# IYZICO_PRODUCTION_API_KEY=
# IYZICO_PRODUCTION_SECRET_KEY=
IYZICO_CALLBACK_URL=https://api.lunova.tr/api/v1/payments/callback/
